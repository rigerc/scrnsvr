{
  "id": "vhs-distortion",
  "title": "VHS Distortion",
  "description": "Analog tape texture, color bleed, and drifting tracking interference.",
  "uniforms": [
    {
      "name": "intensity",
      "label": "Intensity",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "description": "Blend with the original image. Zero bypasses this layer."
    },
    {
      "name": "grain",
      "label": "Grain",
      "type": "float",
      "default": 0.2,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "description": "Animated fine-grained tape noise."
    },
    {
      "name": "scanlines",
      "label": "Scanlines",
      "type": "float",
      "default": 0.25,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "description": "Subtle horizontal scanline shading."
    },
    {
      "name": "colorBleed",
      "label": "Color bleed",
      "type": "float",
      "default": 0.2,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "description": "Separate color channels horizontally."
    },
    {
      "name": "tracking",
      "label": "Tracking distortion",
      "type": "float",
      "default": 0.15,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "description": "Horizontal jitter and a drifting interference band."
    }
  ],
  "source": "effect.glsl"
}
