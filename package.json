{
  "name": "scrnsvr",
  "version": "0.6.0",
  "description": "A shader-based idle screensaver for Linux desktops.",
  "homepage": "https://github.com/rigerc/scrnsvr",
  "author": {
    "name": "rigerc",
    "email": "bond@bsgb.nl"
  },
  "desktopName": "scrnsvr",
  "private": true,
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron dist/main/index.js",
    "open": "npm run build && electron dist/main/index.js --open",
    "settings": "npm run build && electron dist/main/index.js --settings",
    "daemon": "npm run build && electron dist/main/index.js --daemon",
    "typecheck": "node scripts/generate-palettes.mjs && node scripts/generate-shader-registry.mjs && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "quality": "npm run typecheck && npm run coverage && fallow",
    "qlty": "qlty check --all",
    "render-thumbnails": "npm run build && electron dist/main/index.js --thumbnail --output assets/thumbnails --frames 3",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "check-shaders": "npm run build && node scripts/check-shaders.cjs",
    "check-custom-shaders": "npm run build && node scripts/check-custom-shaders.cjs",
    "check-reactive-audio": "npm run build && node scripts/check-reactive-audio.cjs",
    "check-animation-runtime": "npm run build && node scripts/check-animation-runtime.cjs"
  },
  "dependencies": {
    "ogl": "^1.0.11",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fallow": "3.29.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.5.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "electron@44.3.0": true,
    "esbuild@0.28.2": true
  }
}
