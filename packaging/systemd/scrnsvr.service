[Unit]
Description=Scrnsvr idle screensaver daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/scrnsvr --daemon
Restart=on-failure
RestartSec=5
# Exit status 2: no Wayland layer-shell session or native renderer.
RestartPreventExitStatus=2
Environment=ELECTRON_OZONE_PLATFORM_HINT=auto

[Install]
WantedBy=graphical-session.target
